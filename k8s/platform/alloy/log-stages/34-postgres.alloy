// PostgreSQL: 2026-11-05 09:55:13.407 GMT [92] LOG:  ...
stage.match {
  selector = `{namespace=~".+"} |~ "^\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d\\.\\d+ \\S+ \\[\\d+\\] [A-Z]+:"`

  stage.regex {
    expression = `^\S+ \S+ \S+ \[\d+\] (?P<level>[A-Z]+):\s+(?P<message>.*)$`
  }
  stage.static_labels {
    values = { format = "postgres" }
  }
}
