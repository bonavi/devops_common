// JSON: {"level":"warn","message":"...","params":{...}}
stage.match {
  selector = `{namespace=~".+"} |~ "^\\{"`

  stage.json {
    expressions = {
      level      = "level || severity",
      message    = "message || msg",
      systemInfo = "systemInfo",
      params     = "params",
    }
  }
  stage.json {
    expressions = { env = "env" }
    source      = "systemInfo"
  }
  stage.static_labels {
    values = { format = "json" }
  }
}
