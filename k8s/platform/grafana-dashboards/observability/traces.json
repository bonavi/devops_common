{
  "uid": "observability-traces",
  "title": "Трейсы",
  "tags": [
    "traces",
    "tempo",
    "observability"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "links": [
    {
      "title": "Логи",
      "type": "link",
      "url": "/d/observability-logs",
      "icon": "doc"
    },
    {
      "title": "Профили",
      "type": "link",
      "url": "/d/observability-profiles",
      "icon": "doc"
    },
    {
      "title": "Tempo (Explore)",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22:%22tempo%22%7D",
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "service"
        },
        "definition": "label_values(traces_spanmetrics_calls_total, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "span",
        "label": "Спан",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=~\"${service:regex}\"}, span_name)",
          "refId": "span"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=~\"${service:regex}\"}, span_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "min_duration",
        "label": "Медленнее чем",
        "type": "textbox",
        "query": "100ms",
        "current": {
          "text": "100ms",
          "value": "100ms"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "RED по спанам (метрики из трейсов)",
      "id": 100,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросов в секунду",
      "description": "Частота спанов по имени (gRPC-метод, запрос в БД и т. п.)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=~\"${service:regex}\", span_name=~\"${span:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Доля ошибок",
      "description": "Спаны со статусом ERROR от всех",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=~\"${service:regex}\", span_name=~\"${span:regex}\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum by (span_name) (rate(traces_spanmetrics_calls_total{service=~\"${service:regex}\", span_name=~\"${span:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Длительность p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=~\"${service:regex}\", span_name=~\"${span:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Спаны за период",
      "description": "Количество, ошибки и p95 за выбранный интервал",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Вызовов"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ошибок"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Спан"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Вызовов",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (increase(traces_spanmetrics_calls_total{service=~\"${service:regex}\", span_name=~\"${span:regex}\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (increase(traces_spanmetrics_calls_total{service=~\"${service:regex}\", span_name=~\"${span:regex}\", status_code=\"STATUS_CODE_ERROR\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (increase(traces_spanmetrics_latency_bucket{service=~\"${service:regex}\", span_name=~\"${span:regex}\"}[$__range])))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "nodeGraph",
      "title": "Граф сервисов",
      "description": "Кто кого вызывает (service-graphs из Tempo)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ]
    },
    {
      "type": "row",
      "title": "Трейсы",
      "id": 101,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "table",
      "title": "Последние трейсы",
      "description": "Клик по Trace ID открывает трейс",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:regex}\" && name=~\"${span:regex}\"}",
          "tableType": "traces",
          "limit": 50
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Медленные трейсы (> $min_duration)",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:regex}\" && name=~\"${span:regex}\" && duration > $min_duration}",
          "tableType": "traces",
          "limit": 50
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Трейсы с ошибками",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:regex}\" && name=~\"${span:regex}\" && status = error}",
          "tableType": "traces",
          "limit": 50
        }
      ]
    }
  ]
}