{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "observability-logs"
  },
  "spec": {
    "title": "Логи",
    "description": "",
    "tags": [
      "logs",
      "loki",
      "observability"
    ],
    "editable": false,
    "cursorSync": "Off",
    "liveNow": false,
    "preload": false,
    "links": [
      {
        "title": "Трейсы",
        "type": "link",
        "url": "/d/observability-traces",
        "icon": "doc",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": false,
        "keepTime": true
      },
      {
        "title": "Профили",
        "type": "link",
        "url": "/d/observability-profiles",
        "icon": "doc",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": false,
        "keepTime": true
      }
    ],
    "annotations": [],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "30s",
        "1m",
        "5m"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "label": "Loki",
          "pluginId": "loki",
          "hide": "hideVariable",
          "skipUrlSync": false,
          "multi": false,
          "includeAll": false,
          "refresh": "onDashboardLoad",
          "regex": "",
          "allowCustomValue": false,
          "options": [],
          "current": {
            "text": "Loki",
            "value": "Loki"
          }
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "namespace",
          "label": "Namespace",
          "hide": "dontHide",
          "skipUrlSync": false,
          "includeAll": true,
          "multi": true,
          "allValue": ".+",
          "allowCustomValue": true,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": [],
          "definition": "",
          "refresh": "onTimeRangeChanged",
          "regex": "",
          "sort": "alphabeticalAsc",
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "label": "namespace",
              "stream": "",
              "type": 1
            }
          }
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "app",
          "label": "App",
          "hide": "dontHide",
          "skipUrlSync": false,
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "allowCustomValue": true,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": [],
          "definition": "",
          "refresh": "onTimeRangeChanged",
          "regex": "",
          "sort": "alphabeticalAsc",
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "label": "app",
              "stream": "{namespace=~\"${namespace:regex}\"}",
              "type": 1
            }
          }
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "pod",
          "label": "Pod",
          "hide": "dontHide",
          "skipUrlSync": false,
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "allowCustomValue": true,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": [],
          "definition": "",
          "refresh": "onTimeRangeChanged",
          "regex": "",
          "sort": "alphabeticalAsc",
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "label": "pod",
              "stream": "{namespace=~\"${namespace:regex}\", app=~\"${app:regex}\"}",
              "type": 1
            }
          }
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "level",
          "label": "Уровень",
          "hide": "dontHide",
          "skipUrlSync": false,
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "allowCustomValue": true,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": [],
          "query": "error : error|critical|fatal,warn : warn,info : info,debug : debug|trace,без уровня : unknown"
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "search",
          "label": "Поиск (regex)",
          "hide": "dontHide",
          "skipUrlSync": false,
          "query": "",
          "current": {
            "text": "",
            "value": ""
          }
        }
      }
    ],
    "elements": {
      "allVol": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Объём логов по уровням",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (lvl) (count_over_time({namespace=~\"${namespace:regex}\", app=~\"${app:regex}\", pod=~\"${pod:regex}\"} | label_format lvl=`{{ or .level .detected_level \"unknown\" | ToLower | replace \"warning\" \"warn\" }}` | lvl=~\"${level:pipe}\" |~ `(?i)$search` [$__auto]))",
                        "queryType": "range",
                        "legendFormat": "{{lvl}}"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "B",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({namespace=~\"${namespace:regex}\", app=~\"${app:regex}\", pod=~\"${pod:regex}\"} | label_format lvl=`{{ or .level .detected_level \"unknown\" | ToLower | replace \"warning\" \"warn\" }}` | lvl=~\"${level:pipe}\" |~ `(?i)$search` [$__auto]))",
                        "queryType": "range",
                        "legendFormat": "Всего"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "drawStyle": "bars",
                    "fillOpacity": 80,
                    "lineWidth": 0,
                    "stacking": {
                      "group": "A",
                      "mode": "normal"
                    }
                  },
                  "min": 0
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Всего"
                    },
                    "properties": [
                      {
                        "id": "custom.hideFrom",
                        "value": {
                          "legend": false,
                          "tooltip": false,
                          "viz": true
                        }
                      },
                      {
                        "id": "custom.stacking",
                        "value": {
                          "group": "total",
                          "mode": "none"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "/^(error|critical|fatal)$/i"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "/^warn(ing)?$/i"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "yellow",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "/^info$/i"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "green",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "/^unknown$/i"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "#808080",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "legend": {
                  "calcs": [
                    "sum"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            }
          }
        }
      },
