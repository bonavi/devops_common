              "expr": "{namespace=~\"${namespace:regex}\", app=~\"${app:regex}\", pod=~\"${pod:regex}\"} | label_format lvl=`{{ or .level .detected_level \"unknown\" | ToLower | replace \"warning\" \"warn\" }}` | lvl=~\"${level:pipe}\" |~ `(?i)$search` | json log_msg=\"message\", params_raw=\"params\" | drop __error__, __error_details__ | line_format `[{{ .app }}] {{ if .log_msg }}{{ .log_msg }}{{ if .params_raw }}\n└─ {{ .params_raw | replace \"{\\\"\" \"\" | replace \"\\\"}\" \"\" | replace \"\\\":\\\"\" \"=\" | replace \"\\\",\\\"\" \" | \" | replace \"\\\"\" \"\" }}{{ end }}{{ else }}{{ __line__ }}{{ end }}`",
              "maxLines": 500,
              "queryType": "range"
            }
          ]
        }
      ],
      "repeat": "level"
    }
  ]
}