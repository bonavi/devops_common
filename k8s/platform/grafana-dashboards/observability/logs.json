{
  "uid": "observability-logs",
  "title": "Логи",
  "tags": [
    "logs",
    "loki",
    "observability"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "links": [
    {
      "title": "Трейсы",
      "type": "link",
      "url": "/d/observability-traces",
      "icon": "doc"
    },
    {
      "title": "Профили",
      "type": "link",
      "url": "/d/observability-profiles",
      "icon": "doc"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "Loki"
        },
        "hide": 2
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "label": "namespace",
          "stream": "",
          "type": 1,
          "refId": "namespace"
        },
        "definition": "",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "label": "app",
          "stream": "{namespace=~\"${namespace:regex}\"}",
          "type": 1,
          "refId": "app"
        },
        "definition": "",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "label": "pod",
          "stream": "{namespace=~\"${namespace:regex}\", app=~\"${app:regex}\"}",
          "type": 1,
          "refId": "pod"
        },
        "definition": "",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "level",
        "label": "Уровень",
        "type": "custom",
        "query": "error : error|critical|fatal,warn : warn,info : info,debug : debug|trace,без уровня : unknown",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Поиск (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Все логи",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Объём логов по уровням",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Всего"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": false,
                  "viz": true
                }
              },
              {
                "id": "custom.stacking",
                "value": {
                  "group": "total",
                  "mode": "none"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(error|critical|fatal)$/i"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^warn(ing)?$/i"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^info$/i"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^unknown$/i"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#808080",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (lvl) (count_over_time({namespace=~\"${namespace:regex}\", app=~\"${app:regex}\", pod=~\"${pod:regex}\"} | label_format lvl=`{{ or .level .detected_level \"unknown\" | ToLower | replace \"warning\" \"warn\" }}` | lvl=~\"${level:pipe}\" |~ `(?i)$search` [$__auto]))",
          "legendFormat": "{{lvl}}",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({namespace=~\"${namespace:regex}\", app=~\"${app:regex}\", pod=~\"${pod:regex}\"} | label_format lvl=`{{ or .level .detected_level \"unknown\" | ToLower | replace \"warning\" \"warn\" }}` | lvl=~\"${level:pipe}\" |~ `(?i)$search` [$__auto]))",
          "legendFormat": "Всего",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
